<mjml>
  <mj-head>
    <mj-title>An Invitation to [Bride's Name]'s Wedding Planning Portal</mj-title>
    <mj-font name="Inter" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" />
    <mj-attributes>
      <mj-all font-family="Inter, sans-serif" />
      <mj-text line-height="1.6" color="#374151" />
      <mj-button border-radius="9999px" font-weight="500" />
      <mj-section padding="20px 0" />
    </mj-attributes>
    <mj-style>
      body {
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        background-color: #fcfcfc; /* Even lighter, cleaner background */
      }
      .main-wrapper {
        border-radius: 18px; /* Slightly larger, softer rounded corners */
        box-shadow: 0 8px 16px -4px rgba(0,0,0,0.08), 0 4px 8px -2px rgba(0,0,0,0.04); /* Softer shadow */
        border: 1px solid #F3F4F6; /* Subtle border */
      }
      .list-item {
        display: flex;
        align-items: center;
        justify-content: center;
        padding-bottom: 10px; /* Enhanced spacing for readability */
        text-align: left; /* Align text within list item */
        max-width: 380px; /* Constrain width for neatness */
        margin: 0 auto; /* Center the list items */
      }
      .list-icon {
        color: #6B7280; /* Neutral checkmark color for understated elegance */
        font-size: 16px;
        margin-right: 10px;
        line-height: 1;
      }
      .header-bg {
        background-image: linear-gradient(to right, #FFF7F7, #F8F8F8); /* Very soft, neutral gradient */
      }
      .button-style {
        transition: all 0.3s ease;
      }
      .button-style:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 12px -3px rgba(0,0,0,0.1), 0 3px 6px -1px rgba(0,0,0,0.06);
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="#fcfcfc">
    <mj-container background-color="#ffffff" css-class="main-wrapper">
      <!-- Header Section -->
      <mj-section css-class="header-bg" padding="40px 0 30px 0" border-radius="18px 18px 0 0">
        <mj-column>
          <mj-text align="center" font-size="32px" font-weight="600" color="#292524" padding-bottom="12px">
            An Invitation to [Bride's Name]'s Planning Hub
          </mj-text>
          <mj-text align="center" font-size="18px" font-weight="400" color="#44403C">
            Thoughtfully Curated for Our Dearest Wedding Party
          </mj-text>
        </mj-column>
      </mj-section>

      <!-- Main Content Area -->
      <mj-section padding="40px 25px 20px 25px">
        <mj-column>
          <mj-text align="center" font-size="18px" color="#4B5563">
            Hello dear members of [Bride's Name]'s wedding party,
          </mj-text>
          <mj-text align="center" font-size="20px" font-weight="500" color="#1F2937" padding-top="10px">
            We're delighted to invite you to a dedicated space for this exciting journey.
          </mj-text>
        </mj-column>
      </mj-section>

      <mj-section padding="0 25px 20px 25px">
        <mj-column>
          <mj-divider border-color="#F3F4F6" border-width="1px" />
        </mj-column>
      </mj-section>

      <!-- The Purpose: Cleaning Up the Chaos -->
      <mj-section padding="20px 25px">
        <mj-column>
          <mj-text align="center" font-size="24px" font-weight="600" color="#BE123C" padding-bottom="16px">
            Your Seamless Connection to Wedding Preparations
          </mj-text>
          <mj-text align="center" font-size="16px" color="#4B5563" max-width="500px">
            We know wedding planning can sometimes feel like a beautiful but sprawling endeavor, with details spread across emails, texts, and notes. To ensure a truly joyful and *organized* experience for [Bride's Name]—and for you—we've created a central, stylish hub. This portal is designed to bring clarity and ease, making your support effortless and impactful.
          </mj-text>
        </mj-column>
      </mj-section>

      <mj-section padding="0 25px 20px 25px">
        <mj-column>
          <mj-divider border-color="#F3F4F6" border-width="1px" />
        </mj-column>
      </mj-section>

      <!-- Inside the Curated Space -->
      <mj-section padding="20px 25px">
        <mj-column>
          <mj-text align="center" font-size="24px" font-weight="600" color="#44403C" padding-bottom="16px">
            Inside This Curated Space, You'll Find:
          </mj-text>
          <mj-text font-size="16px" color="#4B5563" padding-bottom="0">
            <div class="list-item"><span class="list-icon">&#10003;</span> **Key Dates & Timelines:** All important milestones, beautifully laid out.</div>
            <div class="list-item"><span class="list-icon">&#10003;</span> **Shared Resources:** From attire guidance to registry details, all in one spot.</div>
            <div class="list-item"><span class="list-icon">&#10003;</span> **Central Communication:** A simple way to connect, ask questions, and share updates.</div>
            <div class="list-item"><span class="list-icon">&#10003;</span> **[Bride's Name]'s Vision Board:** Get a peek into her aesthetic for the big day.</div>
          </mj-text>
        </mj-column>
      </mj-section>

      <mj-section padding="0 25px 20px 25px">
        <mj-column>
          <mj-divider border-color="#F3F4F6" border-width="1px" />
        </mj-column>
      </mj-section>

      <!-- Empowering Your Role -->
      <mj-section padding="20px 25px">
        <mj-column>
          <mj-text align="center" font-size="24px" font-weight="600" color="#BE123C" padding-bottom="16px">
            Empowering Your Valuable Support
          </mj-text>
          <mj-text align="center" font-size="16px" color="#4B5563" max-width="500px">
            Your love and presence are invaluable to [Bride's Name]. This portal ensures you have all the information you need, when you need it, allowing your contributions to be meaningful and simple. It's about reducing the usual planning flurry, so everyone can truly enjoy the journey toward our special day.
          </mj-text>
        </mj-column>
      </mj-section>

      <mj-section padding="0 25px 20px 25px">
        <mj-column>
          <mj-divider border-color="#F3F4F6" border-width="1px" />
        </mj-column>
      </mj-section>

      <!-- Call to Action -->
      <mj-section padding="20px 25px 40px 25px">
        <mj-column>
          <mj-text align="center" font-size="24px" font-weight="600" color="#44403C" padding-bottom="24px">
            Step Inside the Planning Hub:
          </mj-text>
          <mj-button href="YOUR_PORTAL_LINK_HERE" background-color="#D7AEAD" color="#FFFFFF" font-size="16px" padding="16px 32px" align="center" css-class="button-style">
            Access the Planning Portal
          </mj-button>
          <mj-text align="center" font-size="14px" color="#6B7280" padding-top="16px">
            (Clicking the link will open [Bride's Name]'s dedicated planning space.)
          </mj-text>
        </mj-column>
      </mj-section>

      <!-- Closing -->
      <mj-section padding="0px 25px 40px 25px">
        <mj-column>
          <mj-text align="center" font-size="18px" color="#4B5563">
            We look forward to navigating this exciting time with you,
            <br />making it as beautiful and effortless as possible.
          </mj-text>
          <mj-text align="center" font-size="20px" font-weight="600" color="#1F2937" padding-top="15px">
            Warmly,
          </mj-text>
          <mj-text align="center" font-size="20px" font-weight="600" color="#1F2937">
            [Your Names]
          </mj-text>
        </mj-column>
      </mj-section>

      <!-- Footer Section -->
      <mj-section background-color="#F8F8F8" padding="20px 0" border-radius="0 0 18px 18px">
        <mj-column>
          <mj-text align="center" font-size="13px" color="#6B7280" padding-bottom="4px">
            &copy; [Year] [Your Names]. All rights reserved.
          </mj-text>
          <mj-text align="center" font-size="13px" color="#6B7280">
            Should any questions arise, please feel free to reply to this email.
          </mj-text>
        </mj-column>
      </mj-section>
    </mj-container>
  </mj-body>
</mjml>
